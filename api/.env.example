# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@host:5432/nombre_base_de_datos?sslmode=disable"

# Secreto para firmar JWT (generá uno con: openssl rand -hex 64)
JWT_SECRET="tu_secreto_largo_aqui"

# Puerto del servidor (opcional, default: 3000)
PORT=3000

# API key para llamadas internas desde n8n (generá una con: openssl rand -hex 32)
N8N_API_KEY="tu_api_key_aqui"
