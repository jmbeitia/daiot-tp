# Base de datos PostgreSQL (la levanta el propio docker-compose.yml, local)
DATABASE_URL="postgresql://daiot_tp:daiot_tp@postgres:5432/daiot_tp?sslmode=disable"

# Secreto para firmar JWT (generá uno con: openssl rand -hex 64)
JWT_SECRET="tu_secreto_largo_aqui"

# Puerto del servidor (opcional, default: 3000)
PORT=3000

# API key para llamadas internas desde n8n (generá una con: openssl rand -hex 32)
N8N_API_KEY="tu_api_key_aqui"

# MQTT (broker Mosquitto propio, mTLS) — certs generados con
# mosquitto/certs/generate-certs.sh y montados en /app/certs dentro del contenedor
MQTT_URL="mqtts://mosquitto:8883"
MQTT_CA_PATH="/app/certs/ca.crt"
MQTT_CERT_PATH="/app/certs/backend.crt"
MQTT_KEY_PATH="/app/certs/backend.key"
